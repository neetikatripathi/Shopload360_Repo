COLUMN TABLE Shopload360_Shoploads (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  machineNo INTEGER,
  temps DECIMAL(6, 2),
  partNumber NVARCHAR(20),
  fai INTEGER,
  ibm NVARCHAR(7),
  quantity INTEGER,
  startDate DATE,
  lrd NVARCHAR(20),
  debit INTEGER,
  pp INTEGER,
  material NVARCHAR(10),
  volume DECIMAL(8, 2),
  clocking NVARCHAR(6),
  mrpCtr NVARCHAR(2),
  signal INTEGER,
  priority INTEGER,
  fixture NVARCHAR(20),
  logs NVARCHAR(20),
  sapStatus NVARCHAR(3),
  logNumber NVARCHAR(10),
  smartlogStatus NVARCHAR(10),
  stockoutEcd NVARCHAR(20),
  remarkIbm NVARCHAR(90),
  commentsForProduction NVARCHAR(90),
  qualityAlert NVARCHAR(3),
  logisticsNotes NVARCHAR(90),
  remarkPartNumber NVARCHAR(90),
  productionDate DATE,
  shoploadedOn DATE,
  productionComments NVARCHAR(90),
  completedDate DATE,
  status NVARCHAR(12),
  machine_ID NVARCHAR(36),
  PRIMARY KEY(ID)
)