COLUMN TABLE shopload360Srv_Shoploads_drafts (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  machineNo INTEGER NULL,
  temps DECIMAL(6, 2) NULL,
  partNumber NVARCHAR(20) NULL,
  fai INTEGER NULL,
  ibm NVARCHAR(7) NULL,
  quantity INTEGER NULL,
  startDate DATE NULL,
  lrd NVARCHAR(20) NULL,
  debit INTEGER NULL,
  pp INTEGER NULL,
  material NVARCHAR(10) NULL,
  volume DECIMAL(8, 2) NULL,
  clocking NVARCHAR(6) NULL,
  mrpCtr NVARCHAR(2) NULL,
  signal INTEGER NULL,
  priority INTEGER NULL,
  fixture NVARCHAR(20) NULL,
  logs NVARCHAR(20) NULL,
  sapStatus NVARCHAR(3) NULL,
  logNumber NVARCHAR(10) NULL,
  smartlogStatus NVARCHAR(10) NULL,
  stockoutEcd NVARCHAR(20) NULL,
  remarkIbm NVARCHAR(90) NULL,
  commentsForProduction NVARCHAR(90) NULL,
  qualityAlert NVARCHAR(3) NULL,
  logisticsNotes NVARCHAR(90) NULL,
  remarkPartNumber NVARCHAR(90) NULL,
  productionDate DATE NULL,
  shoploadedOn DATE NULL,
  productionComments NVARCHAR(90) NULL,
  completedDate DATE NULL,
  status NVARCHAR(12) NULL,
  machine_ID NVARCHAR(36) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)